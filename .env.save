# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000
# When behind exactly one trusted reverse proxy, set to 1. Leave unset for direct/local requests.
TRUST_PROXY_HOPS=
SITE_ROOT=.
DB_PATH=.data/chat.sqlite3

# Generate with: openssl rand -base64 48
AUTH_PEPPER=uzFTdmQ27hbeCn/TUXRdaopYjE99z9zZfVm1Yaa6idRwERJBAGtZxyujwCj8neY7

# SMTP provider for passwordless one-time codes. Use TLS-capable SMTP, usually port 587 or 465.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Nana Julian's Bakery <no-reply@example.com>"
